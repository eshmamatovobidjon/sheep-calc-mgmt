# Required
BOT_TOKEN=123456789:replace-me
ADMIN_TELEGRAM_ID=123456789

# PostgreSQL (docker compose uses these; it replaces localhost with the postgres service)
POSTGRES_USER=sheepbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sheepbot
DATABASE_URL=postgresql+asyncpg://sheepbot:change-me@localhost:5432/sheepbot

# Optional
STORAGE_DIR=./storage
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
COMPANY_NAME=
MAX_UPLOAD_MB=10

# API (Mini App)
WEBAPP_AUTH_MAX_AGE_HOURS=24
# HTTPS address of the Mini App; when set, the bot's menu button opens it.
MINI_APP_URL=
# Local development only: requests without initData act as this Telegram user.
# APP_ENV=dev
# DEV_AUTH_TELEGRAM_ID=
